{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@armin-eslami/gatherform-core": ["./packages/core/src/index.ts"],
      "@armin-eslami/gatherform-react": ["./packages/react/src/index.tsx"],
      "@/*": ["./apps/studio/src/*"]
    }
  },
  "include": ["packages/*/src", "apps/studio/src"]
}
